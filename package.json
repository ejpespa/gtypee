{
  "name": "gtypee",
  "version": "1.20.0",
  "author": "dev.ejpespa@gmail.com",
  "description": "TypeScript CLI for Google Workspace administration - manage Gmail, Drive, Calendar, and 15+ Google services from the command line",
  "main": "dist/src/index.js",
  "bin": {
    "gtypee": "dist/bin/gtypee.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx bin/gtypee.ts",
    "test": "vitest run",
    "test:parity": "vitest run test/parity/**/*.test.ts",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "cli",
    "google",
    "google-workspace",
    "gmail",
    "gmail-cli",
    "google-drive",
    "google-calendar",
    "google-docs",
    "google-sheets",
    "google-slides",
    "google-tasks",
    "google-forms",
    "google-chat",
    "google-classroom",
    "google-keep",
    "google-contacts",
    "google-apps-script",
    "gworkspace",
    "workspace-admin",
    "admin",
    "typescript",
    "command-line",
    "terminal",
    "google-api",
    "googleapis",
    "google-admin-sdk",
    "admin-sdk",
    "oauth2",
    "service-account",
    "domain-wide-delegation",
    "automation",
    "scripting",
    "devops",
    "sysadmin",
    "user-management",
    "email-automation",
    "drive-export",
    "bulk-operations",
    "json-output",
    "google-workspace-cli"
  ],
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejpespa/gtypee.git"
  },
  "bugs": {
    "url": "https://github.com/ejpespa/gtypee/issues"
  },
  "homepage": "https://github.com/ejpespa/gtypee#readme",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "logo.svg"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "googleapis": "^171.4.0",
    "ink": "^7.0.6",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "json5": "^2.2.3",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.17",
    "semantic-release": "^24.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
